# PowerShell: set these in the process environment; Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=saferide_app
DB_PASSWORD=replace_locally
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
# Optional for live trip traffic. Create a personal TomTom Routing API key.
SAFERIDE_TOMTOM_API_KEY=replace_locally
